var NAMA_TAB_ANDA='req lagu';
var TIMEZONE='Asia/Jakarta';
var CACHE_SECONDS=12;
var CACHE_PREFIX='kudajitu_sync_v6_';
function getSheet_(){var s=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(NAMA_TAB_ANDA);if(!s)throw new Error('Sheet "'+NAMA_TAB_ANDA+'" tidak ditemukan');return s;}
function jsonResponse(d){return ContentService.createTextOutput(JSON.stringify(d)).setMimeType(ContentService.MimeType.JSON);}
function jsonpResponse(cb,d){var safe=String(cb||'').replace(/[^a-zA-Z0-9_.$]/g,'');if(!safe)safe='__kudajituCallback';return ContentService.createTextOutput(safe+'('+JSON.stringify(d)+');').setMimeType(ContentService.MimeType.JAVASCRIPT);}
function respond_(cb,d){return cb?jsonpResponse(cb,d):jsonResponse(d);}
function toDate_(v){if(v instanceof Date)return isNaN(v.getTime())?null:new Date(v.getTime());if(!v)return null;var d=new Date(v);return isNaN(d.getTime())?null:d;}
function dateKey_(v){var d=toDate_(v);return d?Utilities.formatDate(d,TIMEZONE,'yyyy-MM-dd'):'';}
function todayKey_(){return Utilities.formatDate(new Date(),TIMEZONE,'yyyy-MM-dd');}
function yesterdayKey_(){var p=todayKey_().split('-'),d=new Date(+p[0],+p[1]-1,+p[2]);d.setDate(d.getDate()-1);return Utilities.formatDate(d,TIMEZONE,'yyyy-MM-dd');}
function normalizeStatus_(v){var s=String(v||'').trim().toLowerCase();return(s==='played'||s==='play'||s==='selesai'||s==='diputar')?'played':'pending';}
function normalizeTimestamp_(v){var d=toDate_(v);return d?d.toISOString():(v?String(v):'');}
function rowToObject_(r){return{id:String(r[0]||''),requester:String(r[1]||''),title:String(r[2]||''),artist:String(r[3]||''),note:String(r[4]||''),timestamp:normalizeTimestamp_(r[5]),status:normalizeStatus_(r[6]),votes:Number(r[7]||1)};}
function cacheGet_(k){try{var v=CacheService.getScriptCache().get(CACHE_PREFIX+k);return v?JSON.parse(v):null;}catch(e){return null;}}
function cachePut_(k,d){try{CacheService.getScriptCache().put(CACHE_PREFIX+k,JSON.stringify(d),CACHE_SECONDS);}catch(e){}}
function clearCaches_(){try{CacheService.getScriptCache().removeAll([CACHE_PREFIX+'today_all',CACHE_PREFIX+'yesterday_all',CACHE_PREFIX+'all_all',CACHE_PREFIX+'today_pending',CACHE_PREFIX+'today_played',CACHE_PREFIX+'yesterday_pending',CACHE_PREFIX+'yesterday_played',CACHE_PREFIX+'all_pending',CACHE_PREFIX+'all_played']);}catch(e){}}
function getRecentRows_(sheet,targetKey){var last=sheet.getLastRow();if(last<2)return[];var ts=sheet.getRange(2,6,last-1,1).getValues(),matched=[];for(var i=ts.length-1;i>=0;i--){var k=dateKey_(ts[i][0]);if(!k)continue;if(k===targetKey)matched.push(i+2);else if(matched.length&&k<targetKey)break;}if(!matched.length)return[];var min=Math.min.apply(null,matched),max=Math.max.apply(null,matched),vals=sheet.getRange(min,1,max-min+1,8).getValues(),out=[];for(var j=0;j<vals.length;j++)if(vals[j][0]&&dateKey_(vals[j][5])===targetKey)out.push(rowToObject_(vals[j]));out.reverse();return out;}
function getAllRows_(sheet){var last=sheet.getLastRow();if(last<2)return[];var vals=sheet.getRange(2,1,last-1,8).getValues(),out=[];for(var i=0;i<vals.length;i++)if(vals[i][0])out.push(rowToObject_(vals[i]));out.reverse();return out;}
function filterStatus_(rows,status){return status==='all'?rows:rows.filter(function(r){return r.status===status;});}
function getIds_(sheet){var last=sheet.getLastRow();if(last<2)return[];return sheet.getRange(2,1,last-1,1).getValues().map(function(r){return String(r[0]||'');});}
function findRowById_(sheet,id){var ids=getIds_(sheet),needle=String(id);for(var i=0;i<ids.length;i++)if(ids[i]===needle)return i+2;return-1;}
function checkIds_(sheet,ids){var existing={};getIds_(sheet).forEach(function(id){existing[id]=true;});return ids.filter(function(id){return existing[String(id)];}).map(String);}
function generateId_(){return'req_'+Date.now()+'_'+Math.random().toString(36).substring(2,8);}
function doGet(e){try{var p=e&&e.parameter?e.parameter:{},cb=p.callback||p.prefix||'',sheet=getSheet_(),action=String(p.action||'data').toLowerCase();if(action==='check'){var ids=String(p.ids||'').split(',').map(function(x){return x.trim();}).filter(Boolean).slice(0,20);var found=checkIds_(sheet,ids);return respond_(cb,{success:true,action:'check',found:found,missing:ids.filter(function(id){return found.indexOf(id)===-1;})});}var range=String(p.range||'today').toLowerCase();if(range!=='today'&&range!=='yesterday'&&range!=='all')range='today';var status=String(p.status||'all').toLowerCase();if(status!=='all'&&status!=='pending'&&status!=='played')status='all';var key=range+'_'+status,cached=cacheGet_(key),data;if(cached!==null)data=cached;else{var rows=range==='today'?getRecentRows_(sheet,todayKey_()):range==='yesterday'?getRecentRows_(sheet,yesterdayKey_()):getAllRows_(sheet);data=filterStatus_(rows,status);cachePut_(key,data);}return respond_(cb,{success:true,cached:cached!==null,range:range,status:status,timezone:TIMEZONE,today:todayKey_(),yesterday:yesterdayKey_(),count:data.length,data:data});}catch(err){return respond_(e&&e.parameter&&(e.parameter.callback||e.parameter.prefix),{success:false,message:String(err),data:[]});}}
function parsePost_(e){if(e&&e.parameter&&e.parameter.payload)return JSON.parse(e.parameter.payload);if(e&&e.postData&&e.postData.contents)return JSON.parse(e.postData.contents);throw new Error('Data POST kosong');}
function appendIfMissing_(sheet,items){var existing={};getIds_(sheet).forEach(function(id){existing[id]=true;});var rows=[],accepted=[];items.forEach(function(item){var id=String(item.id||generateId_());if(existing[id]){accepted.push(id);return;}existing[id]=true;accepted.push(id);rows.push([id,String(item.requester||''),String(item.title||''),String(item.artist||''),String(item.note||''),item.timestamp||new Date().toISOString(),normalizeStatus_(item.status||'pending'),Number(item.votes||1)]);});if(rows.length)sheet.getRange(sheet.getLastRow()+1,1,rows.length,8).setValues(rows);return{accepted:accepted,added:rows.length,existing:accepted.length-rows.length};}
function doPost(e){var lock=LockService.getScriptLock();try{lock.waitLock(10000);var sheet=getSheet_(),data=parsePost_(e),action=String(data.action||'');if(action==='add'){var item={id:String(data.id||generateId_()),requester:String(data.requester||''),title:String(data.title||''),artist:String(data.artist||''),note:String(data.note||''),timestamp:data.timestamp||new Date().toISOString(),status:normalizeStatus_(data.status||'pending'),votes:Number(data.votes||1)};var a=appendIfMissing_(sheet,[item]);clearCaches_();return jsonResponse({success:true,action:'add',id:item.id,added:a.added,existing:a.existing,data:item,message:'Request berhasil diproses'});}if(action==='addBatch'){var raw=Array.isArray(data.items)?data.items:[];if(!raw.length)return jsonResponse({success:false,message:'Tidak ada data batch'});var items=raw.slice(0,3).map(function(x){x=x||{};return{id:String(x.id||generateId_()),requester:String(x.requester||''),title:String(x.title||''),artist:String(x.artist||''),note:String(x.note||''),timestamp:x.timestamp||new Date().toISOString(),status:normalizeStatus_(x.status||'pending'),votes:Number(x.votes||1)};});var b=appendIfMissing_(sheet,items);clearCaches_();return jsonResponse({success:true,action:'addBatch',count:b.accepted.length,added:b.added,existing:b.existing,ids:b.accepted,message:b.added+' request baru diproses'});}if(action==='updateStatus'){var id=String(data.id||'');if(!id)return jsonResponse({success:false,message:'ID tidak ditemukan'});var row=findRowById_(sheet,id);if(row<0)return jsonResponse({success:false,action:'updateStatus',id:id,message:'ID request tidak ditemukan'});var st=normalizeStatus_(data.status||'pending');sheet.getRange(row,7).setValue(st);clearCaches_();return jsonResponse({success:true,action:'updateStatus',id:id,status:st});}if(action==='updateStatuses'){var updates=Array.isArray(data.items)?data.items:[],changed=0;updates.forEach(function(u){var id=String(u&&u.id||''),row=id?findRowById_(sheet,id):-1;if(row>0){sheet.getRange(row,7).setValue(normalizeStatus_(u.status||'played'));changed++;}});clearCaches_();return jsonResponse({success:true,action:'updateStatuses',updated:changed});}if(action==='delete'){var did=String(data.id||''),dr=did?findRowById_(sheet,did):-1;if(dr<0)return jsonResponse({success:false,action:'delete',id:did,message:'ID request tidak ditemukan'});sheet.deleteRow(dr);clearCaches_();return jsonResponse({success:true,action:'delete',id:did});}if(action==='deleteBatch'){var dels=Array.isArray(data.ids)?data.ids.map(String):[];if(!dels.length&&Array.isArray(data.items))dels=data.items.map(function(x){return String(x&&x.id||'');}).filter(Boolean);var ids=getIds_(sheet),rows=[];ids.forEach(function(id,i){if(dels.indexOf(id)!==-1)rows.push(i+2);});rows.sort(function(a,b){return b-a;});rows.forEach(function(r){sheet.deleteRow(r);});clearCaches_();return jsonResponse({success:true,action:'deleteBatch',deleted:rows.length});}return jsonResponse({success:false,message:'Action tidak dikenal: '+action});}catch(err){return jsonResponse({success:false,message:String(err)});}finally{try{lock.releaseLock();}catch(e){}}}
